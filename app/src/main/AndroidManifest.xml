<?xml version="1.0" encoding="utf-8"?>

<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Esta app NO necesita permisos especiales:
        los intents implícitos usados (mapa, web, marcador, SMS y ajustes)
        delegan el trabajo a otras apps del sistema.
    -->

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Prototipo2">

        <!-- ===== INTENTS EXPLÍCITOS: Activities del propio proyecto ===== -->

        <!-- Pantalla de confirmación (devuelve un resultado) -->
        <activity
            android:name=".ConfirmActivity"
            android:exported="false" />

        <!-- Pantalla de ayuda -->
        <activity
            android:name=".AyudaActivity"
            android:exported="false" />

        <!-- Pantalla de detalle (recibe datos con putExtra) -->
        <activity
            android:name=".DetalleActivity"
            android:exported="false" />

        <!-- ===== PANTALLA PRINCIPAL ===== -->
        <activity
            android:name=".MainActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

    </application>

</manifest>
